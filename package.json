{
  "name": "conifer-sdk",
  "version": "0.1.0",
  "description": "The Conifer gateway SDK: one client, exact per-turn cost receipts, and honest migration shims from OpenRouter, Vercel AI Gateway, and Helicone.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "conifer-mcp": "bin/conifer-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cards",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/run-tests.mjs",
    "qa:live": "node scripts/live-qa.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConiferKit/use-conifer.git"
  },
  "homepage": "https://conifer.build/docs/sdk/conifer/",
  "bugs": {
    "url": "https://github.com/ConiferKit/use-conifer/issues"
  },
  "keywords": [
    "conifer",
    "llm",
    "openai",
    "anthropic",
    "gateway",
    "ai",
    "sdk",
    "mcp"
  ],
  "author": "Conifer"
}
