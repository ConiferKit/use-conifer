{
  "_comment": "Conifer's public wire contract, vendored here and pinned by the SDK test suites. Do not edit by hand.",
  "version": 1,
  "receipt_headers": [
    "x-conifer-requested-model",
    "x-conifer-effective-model",
    "x-conifer-receipt-reason",
    "x-conifer-endpoint",
    "x-conifer-cost-nanousd",
    "x-conifer-cost-components-nanousd",
    "x-conifer-service-tier",
    "x-conifer-receipt-venue",
    "x-conifer-counterfactual-nanousd"
  ],
  "request_id_header": "x-conifer-request-id",
  "error_envelope": {
    "_comment": "The API's error vocabulary, pinned by tests/errors.test.ts and python/tests/test_sdk.py. `type` alone is not a reliable discriminator: clients should discriminate on (type, code, status).",
    "types": [
      "invalid_request_error",
      "rate_limit_error",
      "model_not_found",
      "job_not_found",
      "insufficient_allowance",
      "cost_ceiling_exceeded",
      "key_spend_cap_exceeded",
      "request_in_progress",
      "unknown_provider",
      "byok_key_rejected",
      "service_unavailable",
      "upstream_error",
      "wire_upstream_mismatch",
      "internal_error"
    ],
    "codes": [
      "invalid_api_key",
      "insufficient_quota",
      "context_length_exceeded",
      "rate_limit_exceeded",
      "model_not_found",
      "unknown_url",
      "method_not_allowed",
      "unsupported_parameter",
      "invalid_value"
    ],
    "retired_types": [
      "unauthorized",
      "invalid_request",
      "rate_limited"
    ],
    "retryable_409_marker": "retry shortly",
    "_409_comment": "Some `request_in_progress` 409s are retryable and some are not. Retryable ones end in the literal phrase 'retry shortly'; clients should key on that phrase."
  },
  "timeouts_secs": {
    "edge_silent_cut": 300,
    "upstream": 280,
    "stream_max": 2400,
    "stream_idle": 120
  }
}
