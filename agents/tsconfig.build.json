{
  // The PUBLISH build. `src/*.ts` is the source of truth for development and
  // for the repo's own tests (which run under node --experimental-strip-types),
  // but a consumer must not need a flag: a package whose entry point is a raw
  // .ts file fails outright on Node 22 with ERR_UNKNOWN_FILE_EXTENSION, and
  // "works on my Node" is not a distribution strategy. So we emit real ESM plus
  // .d.ts into dist/, and package.json points there.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "bin/**/*.ts"]
}
